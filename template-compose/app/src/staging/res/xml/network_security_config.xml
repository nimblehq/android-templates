<network-security-config>
    <!-- Staging builds are internal only (Firebase App Distribution). -->
    <!-- User added CAs are trusted so that a proxy can inspect HTTPS traffic. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
